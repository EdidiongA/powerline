# Household UTC offset in hours (1 = Lagos)
TZ_OFFSET=1

PORT=3000
HOST=127.0.0.1
ALLOWED_ORIGINS=
# Store: disk (default) or dynamodb
STORE=disk
DATA_DIR=./data
# DYNAMO_TABLE=powerline
# DYNAMO_MAX_ATTEMPTS=6

# Session hygiene
SESSION_TTL_MS=1800000
TELEMETRY_TTL_MS=10000
DEMO_USER_ID=demo-household

# Telemetry: sim | victron | growatt
POWER_SOURCE=sim
SIM_ARRAY_KW=4.5
SIM_BATTERY_KWH=10
SIM_SPEED=60
# SIM_START_SOC=29
# SIM_CLOCK_START=2026-09-09T20:30:00Z

# Alerts (server→client over the GET SSE stream)
ALERT_INTERVAL_MS=30000
ALERT_REPEAT_MS=900000

# Victron VRM
# VRM_TOKEN=
# VRM_DEMO=1
# VRM_SITE_ID=219742

# Growatt
# GROWATT_TOKEN=
# GROWATT_BASE_URL=https://openapi.growatt.com/v1
# GROWATT_PLANT_ID=
# GROWATT_DEVICE_SN=
# GROWATT_DEVICE_TYPE=5

# AWS Builder mini-challenge
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0
