# Household UTC offset in hours (1 = Lagos)
TZ_OFFSET=1

PORT=3000
HOST=127.0.0.1
# Require bearer tokens on /mcp; the token identifies the household (leave unset for local development)
# API_TOKENS=lagos-home:change-me-to-a-long-random-secret
ALLOWED_ORIGINS=
# Public origin for OAuth account-linking metadata when a proxy hides it (the ECS Express Mode load balancer sets x-forwarded-* already)
# PUBLIC_URL=https://powerline.example.com
# Store: disk (default) or dynamodb
STORE=disk
DATA_DIR=./data
# DYNAMO_TABLE=powerline
# DYNAMO_MAX_ATTEMPTS=6

# Session hygiene
SESSION_TTL_MS=21600000
TELEMETRY_TTL_MS=10000
DEMO_USER_ID=demo-household

# Telemetry: sim | victron | growatt
POWER_SOURCE=sim
SIM_ARRAY_KW=4.5
SIM_BATTERY_KWH=10
SIM_SPEED=60
# SIM_START_SOC=29
# SIM_CLOCK_START=2026-09-09T20:30:00Z

# History: one reading an hour per household is recorded whether or not anyone is connected.
# With simulated telemetry, give a household with no readings this many days of plausible history on start.
# SEED_HISTORY_DAYS=7
# SIM_CUTOFF_SOC=10
# SIM_STEADY=1        # same reading every time for a given hour (filming, screenshots)

# Weather-aware solar forecast (Open-Meteo, free, no key). Lagos: 6.52 / 3.38
# WEATHER_LAT=6.52
# WEATHER_LON=3.38

# Alerts (server→client over the GET SSE stream)
ALERT_INTERVAL_MS=30000
ALERT_REPEAT_MS=900000

# Victron VRM
# VRM_TOKEN=
# VRM_DEMO=1
# VRM_SITE_ID=219742

# Growatt
# GROWATT_TOKEN=
# GROWATT_BASE_URL=https://openapi.growatt.com/v1
# GROWATT_PLANT_ID=
# GROWATT_DEVICE_SN=
# GROWATT_DEVICE_TYPE=5

# AWS Builder mini-challenge
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# BEDROCK_TIMEOUT_MS=15000

# Prepaid units (set_meter, prepaid_units, buy_units). Default: a simulated vendor — no network, no money.
# UNITS_VENDOR=sim
# VTpass sandbox (free account at sandbox.vtpass.com → Account → API Keys). Test meter 1111111111111 vends; others fail.
# UNITS_VENDOR=vtpass
# VTPASS_API_KEY=
# VTPASS_SECRET_KEY=
# A live (real-money) endpoint is refused unless VTPASS_ALLOW_LIVE=1 is also set.
# VTPASS_BASE_URL=https://sandbox.vtpass.com/api
# Spending ceilings in naira: per purchase and per rolling 24 hours
# UNITS_MAX_NGN=20000
# UNITS_DAILY_NGN=50000
